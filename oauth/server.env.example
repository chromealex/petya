# Optional FUTURE hosted broker. Not used by desktop app. Local pilot parameters are in local/callbacks.json.
# Template for a FUTURE OAuth server; desktop app does not consume this file.
# Set real domain after choosing hosting. Keep client secrets off desktop builds.
PETYA_AUTH_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Populate redirect URLs using scripts/prepare-oauth.cjs
SLACK_REDIRECT_URI=
NOTION_REDIRECT_URI=
ATLASSIAN_REDIRECT_URI=
