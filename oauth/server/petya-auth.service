[Unit]
Description=Petya Atlassian OAuth broker
After=network-online.target
Wants=network-online.target
[Service]
User=petya-auth
Group=petya-auth
WorkingDirectory=/opt/petya-auth
EnvironmentFile=/etc/petya-auth.env
ExecStart=/usr/bin/node /opt/petya-auth/gateway.cjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/petya-auth
UMask=0077
MemoryMax=256M
[Install]
WantedBy=multi-user.target
